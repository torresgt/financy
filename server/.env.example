# Porta HTTP da API
PORT=4000

# Ambiente de execução: development | production | test
NODE_ENV=development

# Segredo usado para assinar os tokens JWT (use um valor longo e aleatório)
JWT_SECRET=

# Tempo de expiração do token JWT (ex.: 1h, 7d)
JWT_EXPIRES_IN=7d

# URL de conexão do banco SQLite (relativa à raiz do projeto)
DATABASE_URL="file:./dev.db"

# Origens permitidas pelo CORS, separadas por vírgula (use * para liberar todas)
CORS_ORIGIN=http://localhost:5173

# URL pública do front-end (usada no link de redefinição de senha)
APP_URL=http://localhost:5173

# Validade, em minutos, do link de redefinição de senha
PASSWORD_RESET_TOKEN_TTL_MINUTES=30

# SMTP para envio de e-mails. Obrigatório em produção.
# Em desenvolvimento, se SMTP_HOST ficar vazio, o e-mail é exibido no console.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Financy <no-reply@financy.local>"
