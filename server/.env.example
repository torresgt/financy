# Porta HTTP da API
PORT=4000

# Ambiente de execução: development | production | test
NODE_ENV=development

# Segredo usado para assinar os tokens JWT (troque por um valor longo e aleatório em produção)
JWT_SECRET="dev-secret-change-in-production"

# Tempo de expiração do token JWT (ex.: 1h, 7d)
JWT_EXPIRES_IN=7d

# URL de conexão do banco SQLite (relativa à raiz do projeto)
DATABASE_URL="file:./dev.db"

# Origens permitidas pelo CORS, separadas por vírgula (use * para liberar todas)
CORS_ORIGIN=http://localhost:5173

# Validade, em minutos, do código de redefinição de senha enviado por e-mail
PASSWORD_RESET_CODE_TTL_MINUTES=15
# Intervalo mínimo, em segundos, entre dois envios de código para o mesmo usuário
PASSWORD_RESET_RESEND_COOLDOWN_SECONDS=60

# SMTP para envio de e-mails. Obrigatório em produção.
# Em desenvolvimento, se SMTP_HOST ficar vazio, o e-mail é exibido no console.
# Ao subir, o servidor confere a conexão e mostra no log se o SMTP está OK.
#
# Exemplos (use SEMPRE uma senha de app / chave de API, nunca a senha da conta):
#   Gmail:   SMTP_HOST=smtp.gmail.com     SMTP_PORT=465  SMTP_SECURE=true
#            (exige verificação em 2 etapas + "Senhas de app" na Conta Google)
#   Brevo:   SMTP_HOST=smtp-relay.brevo.com SMTP_PORT=587 SMTP_SECURE=false
#   Resend:  SMTP_HOST=smtp.resend.com    SMTP_PORT=465  SMTP_SECURE=true  SMTP_USER=resend
# Em Gmail/Outlook, MAIL_FROM deve usar o mesmo endereço do SMTP_USER.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Financy <no-reply@financy.local>"
