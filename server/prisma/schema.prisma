generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  password     String
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  categories           Category[]
  transactions         Transaction[]
  passwordResetTokens  PasswordResetToken[]

  @@map("users")
}

/// Pedido de redefinição de senha confirmado por um código de 6 dígitos enviado
/// por e-mail. O código e a nova senha ficam guardados apenas como hash bcrypt;
/// a senha só é aplicada quando o código correto é informado.
model PasswordResetToken {
  id              String    @id @default(cuid())
  codeHash        String    @map("code_hash")
  newPasswordHash String    @map("new_password_hash")
  /// Tentativas erradas de código; ao atingir o limite o pedido é invalidado
  attempts        Int       @default(0)
  userId    String    @map("user_id")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model Category {
  id           String        @id @default(cuid())
  title        String
  description  String?
  icon         String        @default("tag")
  color        String        @default("blue")
  userId       String        @map("user_id")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@unique([userId, title])
  @@index([userId])
  @@map("categories")
}

enum TransactionType {
  INCOME
  EXPENSE
}

model Transaction {
  id          String          @id @default(cuid())
  description String
  /// Valor armazenado em centavos para evitar erros de ponto flutuante
  amount      Int
  type        TransactionType
  date        DateTime
  categoryId  String?         @map("category_id")
  userId      String          @map("user_id")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  category    Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([userId, date])
  @@index([categoryId])
  @@map("transactions")
}
