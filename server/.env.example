# Porta HTTP da API
PORT=4000

# Ambiente de execução: development | production | test
NODE_ENV=development

# Segredo usado para assinar os tokens JWT (use um valor longo e aleatório)
JWT_SECRET=

# Tempo de expiração do token JWT (ex.: 1h, 7d)
JWT_EXPIRES_IN=7d

# URL de conexão do banco SQLite (relativa à raiz do projeto)
DATABASE_URL="file:./dev.db"

# Origens permitidas pelo CORS, separadas por vírgula (use * para liberar todas)
CORS_ORIGIN=http://localhost:5173
